        // Persistent Data Engine
        function loadPersistentData() {
            const storedItems = localStorage.getItem("ktm_media_items");
            if (storedItems) {
                try {
                    mediaItems = JSON.parse(storedItems);
                } catch(e) {
                    mediaItems = [...initialDefaultItems];
                }
            } else {
                mediaItems = [...initialDefaultItems];
                saveMediaItemsToStorage();
            }

            let visitorCount = localStorage.getItem("ktm_visitor_count");
            if (!visitorCount) {
                visitorCount = 12540;
                localStorage.setItem("ktm_visitor_count", visitorCount);
            } else {
                visitorCount = parseInt(visitorCount) + 1;
                localStorage.setItem("ktm_visitor_count", visitorCount);
            }
            document.getElementById("globalVisitorCounter").innerText = Number(visitorCount).toLocaleString('en-IN');
        }

        function saveMediaItemsToStorage() {
            localStorage.setItem("ktm_media_items", JSON.stringify(mediaItems));
        }

