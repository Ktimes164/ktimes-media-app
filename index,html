        function loadCategories() {
            const container = document.getElementById("categoryContainer");
            container.innerHTML = categories.map(cat => `
                <button onclick="selectCategory('${cat}')" 
                        class="px-4 py-2 rounded-xl text-xs md:text-sm font-extrabold whitespace-nowrap transition ${cat === currentCategory ? 'bg-brandPurple text-white shadow-md' : 'bg-gray-200 text-gray-800 hover:bg-gray-300'}">
