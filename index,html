        // Audio Player
        function playAudio(id, url, title, category, thumb, waText) {
            if (currentPlayingId == id) {
                if (globalAudio.paused) globalAudio.play();
                else globalAudio.pause();
            } else {
                currentPlayingId = id;
                globalAudio.src = url;
                globalAudio.play();

                const item = mediaItems.find(i => i.id == id);
                if (item) {
                    item.views = (item.views || 0) + 1;
                    saveMediaItemsToStorage();
                }

                document.getElementById("playerTitle").innerText = title;
                document.getElementById("playerCategory").innerText = category;
                document.getElementById("playerThumb").src = thumb;
                document.getElementById("playerWhatsappLink").href = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;
                document.getElementById("bottomAudioPlayer").classList.remove("hidden");
            }
            updatePlayIcons();
        }

        function toggleGlobalAudio() {
            if (globalAudio.paused) globalAudio.play();
            else globalAudio.pause();
            updatePlayIcons();
        }

        function updatePlayIcons() {
            const globalIcon = document.getElementById("globalPlayIcon");
            if (globalIcon) {
                globalIcon.className = globalAudio.paused ? "fas fa-play" : "fas fa-pause";
            }
            filterMedia();
        }

        function updateProgressBar() {
            if (globalAudio.duration) {
                const pct = (globalAudio.currentTime / globalAudio.duration) * 100;
                document.getElementById("audioProgressBar").style.width = `${pct}%`;
            }
        }

        function seekAudio(e) {
            const bg = document.getElementById("audioProgressBg");
            const rect = bg.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            if (globalAudio.duration) {
                globalAudio.currentTime = pos * globalAudio.duration;
            }
        }

        function closeAudioPlayer() {
            globalAudio.pause();
            currentPlayingId = null;
            document.getElementById("bottomAudioPlayer").classList.add("hidden");
            updatePlayIcons();
        }

        // Video Modal
        function openVideoModal(id) {
            const item = mediaItems.find(i => i.id == id);
            if (!item) return;

            item.views = (item.views || 0) + 1;
            saveMediaItemsToStorage();
            filterMedia();

            document.getElementById("videoModalTitle").innerText = item.title;
            document.getElementById("videoModalCategory").innerText = `${item.category} • ${item.aspectRatio || '16:9'}`;
            document.getElementById("videoModalDesc").innerText = item.description;
            document.getElementById("videoModalPrice").innerText = item.priceOrEstimate;

            const waMsg = `नमस्कार Ktimes Media, मला '${item.title}' (${item.sampleId}) हा व्हिडिओ सॅम्पल आवडला असून मला ही जाहिरात बनवायची आहे.`;
            document.getElementById("videoModalWaBtn").href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(waMsg)}`;

            const embedContainer = document.getElementById("videoEmbedContainer");
            const embedUrl = getYouTubeEmbedUrl(item.mediaUrl);
            const aspectClass = getAspectRatioClass(item.aspectRatio);

            if (embedUrl.includes("youtube.com/embed/")) {
                embedContainer.className = `w-full ${aspectClass} max-w-full rounded-lg overflow-hidden border border-gray-800 shadow-xl`;
                embedContainer.innerHTML = `
                    <iframe src="${embedUrl}" title="${item.title}" 
                            class="w-full h-full" frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                            allowfullscreen></iframe>
                `;
            } else {
                embedContainer.className = `w-full ${aspectClass} max-w-full rounded-lg overflow-hidden bg-black flex items-center justify-center`;
                embedContainer.innerHTML = `
                    <video src="${item.mediaUrl}" controls autoplay class="w-full h-full object-contain"></video>
                `;
            }

            document.getElementById("videoModal").classList.remove("hidden");
        }

        function closeVideoModal() {
            document.getElementById("videoEmbedContainer").innerHTML = "";
            document.getElementById("videoModal").classList.add("hidden");
        }

        // Image Modal
        function openImageModal(id) {
            const item = mediaItems.find(i => i.id == id);
            if (!item) return;

            item.views = (item.views || 0) + 1;
            saveMediaItemsToStorage();
            filterMedia();

            document.getElementById("imageModalTitle").innerText = item.title;
            document.getElementById("imageModalSrc").src = item.mediaUrl || item.thumbnailUrl;
            document.getElementById("imageModalDesc").innerText = item.description;
            document.getElementById("imageModalPrice").innerText = item.priceOrEstimate;

            const waMsg = `नमस्कार Ktimes Media, मला '${item.title}' (${item.sampleId}) हा ग्राफिक्स पोस्टर सॅम्पल आवडला आहे.`;
            document.getElementById("imageModalWaBtn").href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(waMsg)}`;

            document.getElementById("imageModal").classList.remove("hidden");
