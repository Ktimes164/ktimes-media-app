            document.getElementById("newAspectRatio").value = "16:9";
            document.getElementById("newMediaUrl").value = "";
            document.getElementById("newThumbnailUrl").value = "";
            document.getElementById("newDescription").value = "";
            document.getElementById("newPrice").value = "₹२,४९९ पासून";
