        function autoSelectAspectRatio() {
            const type = document.getElementById("newMediaType").value;
            const aspectSelect = document.getElementById("newAspectRatio");
            if (type === "VIDEO") aspectSelect.value = "16:9";
            else if (type === "GRAPHIC") aspectSelect.value = "1:1";
            else if (type === "AUDIO") aspectSelect.value = "16:9";
        }

        function handleSaveMedia(e) {
            e.preventDefault();
            if (!isAdminMode) return;

            const editId = document.getElementById("editingItemId").value;
            const sampleId = document.getElementById("newSampleId").value;
            const title = document.getElementById("newTitle").value;
            const category = document.getElementById("newCategory").value;
            const mediaType = document.getElementById("newMediaType").value;
            const aspectRatio = document.getElementById("newAspectRatio").value;
            const mediaUrl = document.getElementById("newMediaUrl").value;
            let thumbnailUrl = document.getElementById("newThumbnailUrl").value;
            const description = document.getElementById("newDescription").value;
            const priceOrEstimate = document.getElementById("newPrice").value || "₹२,४९९ पासून";
            const views = parseInt(document.getElementById("newViews").value) || 100;

            if (!thumbnailUrl) {
                thumbnailUrl = `https://picsum.photos/seed/${sampleId.toLowerCase()}/600/400`;
            }

            const waMsg = `नमस्कार Ktimes Media, मला '${title}' (${sampleId}) बद्दल चौकशी करायची आहे.`;

            if (editId) {
                const idx = mediaItems.findIndex(i => i.id == editId);
                if (idx !== -1) {
                    mediaItems[idx] = {
                        ...mediaItems[idx],
                        sampleId, title, category, mediaType, aspectRatio, mediaUrl, thumbnailUrl, description, priceOrEstimate, views, whatsappMsg: waMsg
                    };
                }
            } else {
                const newItem = {
                    id: Date.now(),
                    sampleId, title, category, mediaType, aspectRatio, mediaUrl, thumbnailUrl, description, priceOrEstimate, views,
                    tags: `${category}, ${title}, ${sampleId}`,
                    whatsappMsg: waMsg
                };
                mediaItems.unshift(newItem);
            }

            saveMediaItemsToStorage();
            filterMedia();
            closeAdminModal();
            alert("सॅम्पल यशस्वीपणे सेव्ह झाले!");
        }

        function editSampleItem(id) {
            if (!isAdminMode) return;
            const item = mediaItems.find(i => i.id == id);
            if (!item) return;

            document.getElementById("editingItemId").value = item.id;
            document.getElementById("sampleFormModalTitle").innerText = "सॅम्पल एडिट करा (Edit Sample)";
            document.getElementById("newSampleId").value = item.sampleId;
            document.getElementById("newTitle").value = item.title;
            document.getElementById("newCategory").value = item.category;
            document.getElementById("newMediaType").value = item.mediaType;
            document.getElementById("newAspectRatio").value = item.aspectRatio || "16:9";
            document.getElementById("newMediaUrl").value = item.mediaUrl;
            document.getElementById("newThumbnailUrl").value = item.thumbnailUrl;
            document.getElementById("newDescription").value = item.description;
            document.getElementById("newPrice").value = item.priceOrEstimate;
            document.getElementById("newViews").value = item.views || 0;

            document.getElementById("adminModal").classList.remove("hidden");
        }

        function deleteSampleItem(id) {
            if (!isAdminMode) return;
            if (confirm("तुम्हाला हे सॅम्पल हटवायचे आहे का?")) {
                mediaItems = mediaItems.filter(i => i.id != id);
                saveMediaItemsToStorage();
                filterMedia();
            }
        }
    </script>
